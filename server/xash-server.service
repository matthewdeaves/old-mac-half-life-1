[Unit]
Description=Half-Life dedicated server (Xash3D FWGS)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=halflife
Group=halflife
WorkingDirectory=/opt/half-life-server

# maxplayers is `+maxplayers`, with a plus, not a minus. It is a cvar
# (sv_maxclients, registered under the name "maxplayers"), so `-maxplayers 8`
# is not an engine option and is quietly ignored: the server comes up with the
# dedicated default of 4 and nothing says why.
#
# It has to be on the command line rather than in server.cfg because the cvar
# is FCVAR_LATCH, so a value set after the map has loaded does not apply until
# the next restart. Command-line +commands run before +map, which is early
# enough.
#
# The console FIFO: a plain redirect would be no good, because the server sees
# EOF and stops reading the moment a writer closes, so exactly one command
# would ever work. Opening the FIFO read-write on fd 3 keeps a writer attached
# from the server's own side, so it never reaches EOF. After that:
#
#     echo "changelevel crossfire" > /run/half-life-server/console
RuntimeDirectory=half-life-server
RuntimeDirectoryMode=0750
ExecStartPre=/usr/bin/mkfifo -m 0600 /run/half-life-server/console
ExecStart=/bin/sh -c 'exec 3<>/run/half-life-server/console; \
    exec /opt/half-life-server/xash \
        -dedicated \
        +maxplayers 8 \
        +map crossfire <&3'

Restart=on-failure
RestartSec=5s

# This is a 1998 UDP protocol with no encryption, reachable from the internet.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
CapabilityBoundingSet=
RestrictSUIDSGID=true
UMask=0077
ProtectProc=invisible
ProcSubset=pid
ProtectHostname=true
ProtectClock=true
PrivateUsers=true

# Seccomp. @system-service is the standard allow-list for a long-running
# daemon; everything outside it returns EPERM rather than killing the process,
# so an exploit that reaches for execve or ptrace gets an error instead of a
# shell.
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete @cpu-emulation @debug @mount @swap @reboot @module
SystemCallErrorNumber=EPERM

# Bound the blast radius of a memory-exhaustion bug. These are generous for a
# game server carrying a handful of players and still stop one process taking
# the whole box down.
MemoryMax=1G
TasksMax=64
LimitNOFILE=1024
LimitCORE=0

# The engine writes configs, logs and downloads under the game directory.
ReadWritePaths=/opt/half-life-server/valve

[Install]
WantedBy=multi-user.target
